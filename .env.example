# The AI Architect Panel — Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ─── AI Provider (NVIDIA NIMs) ──────────────────────────────────────────
# Get your API key from NVIDIA AI Foundation Models:
#   https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ─── Demo Mode ──────────────────────────────────────────────────────────
# Set to true to use mock responses (no API key needed).
# Set to false (or remove) to use live NVIDIA NIMs API.
DEMO_MODE=true

# ─── Error Tracking (Sentry) ───────────────────────────────────────────
# Get your DSN from https://sentry.io/settings/projects/<project>/keys/
# Leave blank to disable Sentry.
SENTRY_DSN=

# ─── Logging ────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── Streamlit ──────────────────────────────────────────────────────────
# These can also be set via Streamlit config (.streamlit/config.toml)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
